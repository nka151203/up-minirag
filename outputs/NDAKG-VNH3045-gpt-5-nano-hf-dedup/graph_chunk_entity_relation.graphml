      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The United States' Strategic Services (OSS) cooperated with Việt Minh to share intelligence on Japanese activities during World War II."&lt;SEP&gt;"U.S. Office of Strategic Services; intelligence partner of Việt Minh during WWII for information on Japanese activities."</data>
      <data key="d2">chunk-b60881720494b2801d1866f2d58b8eb9</data>
    </node>
