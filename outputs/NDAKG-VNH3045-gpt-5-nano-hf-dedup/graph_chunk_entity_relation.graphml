      <data key="d0">"LOCATION"</data>
      <data key="d1">"Diễn Thành is a town in huyện Diễn Châu; part of the region's revolutionary memory."</data>
      <data key="d2">chunk-bfe0d1be514abeb684ef939716ecf874</data>
    </node>
