      <data key="d2">chunk-6bc2794dad524831d7084c6c23b70cd1</data>
    </node>
    <node id="&quot;VƯƠNG QUỐC LÂM ẤP&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Kingdom of Champa; flourished due to its strategic position on ancient trade routes between the Middle East, China, India and Indonesian islands."&lt;SEP&gt;"Lâm Ấp (Cham Pa) was a Cham kingdom that thrived as a regional power in maritime trade and cultural exchange."</data>
      <data key="d2">chunk-6bc2794dad524831d7084c6c23b70cd1</data>
    </node>
    <node id="&quot;KHÁNH HÒA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Coastal region where Khmer attacks on Champa occurred, notably at Kauthara in 950."</data>
