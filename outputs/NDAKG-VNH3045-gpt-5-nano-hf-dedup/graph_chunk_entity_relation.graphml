      <data key="d2">chunk-dae09351baefd2c96da656733c534ccd</data>
    </node>
    <node id="&quot;CÔNG GIÁO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Công giáo (Catholic Church) is referenced as a religious institution involved in the day’s ceremonies, with churches in Hanoi participating."</data>
      <data key="d2">chunk-dae09351baefd2c96da656733c534ccd</data>
    </node>
