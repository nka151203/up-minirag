      <data key="d2">chunk-3bfa206adeee22a1ede2ef2ae0ad9711</data>
    </node>
    <node id="&quot;TỔNG KHỞI NGHĨA HÀ NỘI&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A major uprising in Hanoi during the August Revolution, contributing to the collapse of colonial rule."&lt;SEP&gt;"Hanoi General Uprising on August 19, 1945, with mass demonstrations and the protection by local militias."</data>
      <data key="d2">chunk-9fff36ca9411ec2bf48b0a366dd7589f&lt;SEP&gt;chunk-3bfa206adeee22a1ede2ef2ae0ad9711</data>
    </node>
    <node id="&quot;HUY CẬN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Huy Cận was a Vietnamese revolutionary and poet who participated in the Tan Trao discussions and uprising planning."</data>
      <data key="d2">chunk-3bfa206adeee22a1ede2ef2ae0ad9711</data>
    </node>
    <node id="&quot;CAO HỒNG LÃNH&quot;">
      <data key="d0">"PERSON"</data>
