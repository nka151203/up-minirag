      <data key="d0">"PERSON"</data>
      <data key="d1">"Vietnamese revolutionary and military leader involved in the uprising movements.</data>
      <data key="d2">chunk-3bfa206adeee22a1ede2ef2ae0ad9711</data>
    </node>
    <node id="&quot;TỐ HỮU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Vietnamese poet and revolutionary who supported and participated in the independence movement."</data>
      <data key="d2">chunk-3bfa206adeee22a1ede2ef2ae0ad9711</data>
    </node>
    <node id="&quot;THANH NIÊN TỰ VỆ&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"A self-defense youth militia that provided protection during mass mobilizations and uprisings in cities like Hanoi."</data>
      <data key="d2">chunk-3bfa206adeee22a1ede2ef2ae0ad9711</data>
    </node>
