      <data key="d0">"PERSON"</data>
      <data key="d1">"Vietnamese revolutionary who was a member of the National Uprising Committee and contributed to the uprising's planning and execution."</data>
      <data key="d2">chunk-3bfa206adeee22a1ede2ef2ae0ad9711</data>
    </node>
    <node id="&quot;CHU VĂN TẤN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Vietnamese revolutionary and member of the National Uprising Committee who participated in leadership of the uprising."</data>
      <data key="d2">chunk-3bfa206adeee22a1ede2ef2ae0ad9711</data>
    </node>
    <node id="&quot;TRẦN HUY LIỆU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Minister of Information and Propaganda; reports the abdication of Bao Đại in Huế and hands over the royal sword and seal to Hồ Chí Minh."&lt;SEP&gt;"Trần Huy Liệu was a representative of Việt Minh who spoke at the abdication ceremony and later acted as a liaison figure within the Việt Minh leadership in the push for Vietnam's independence."&lt;SEP&gt;"Vietnamese revolutionary sent to Huế to urge the uprising as part of the campaign to spread the general uprising."</data>
      <data key="d2">chunk-dae09351baefd2c96da656733c534ccd&lt;SEP&gt;chunk-0858721f576cf19954031c342a7d2bff&lt;SEP&gt;chunk-3bfa206adeee22a1ede2ef2ae0ad9711</data>
    </node>
