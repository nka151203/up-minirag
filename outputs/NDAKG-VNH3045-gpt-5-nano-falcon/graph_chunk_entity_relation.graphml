    <node id="&quot;NÀ NGẦN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"A fort about 25 km from Phai Khắt, occupied by 22 French soldiers and commanded by two French officers; attacked by Viet Minh in December 1944."&lt;SEP&gt;"Đồn Nà Ngần (Nà Ngần Fort) located about 25 km from Phai Khắt; attacked by Viet Nam Tuyên truyền Giải phóng quân on 26 December 1944; 22 French troops were present."</data>
      <data key="d2">chunk-7418e6f1b899c505272caee02f3cf1ff</data>
      <data key="d3">1944</data>
      <data key="d4">NÀ NGẦN&lt;SEP&gt;NÀ NGẦN FORT&lt;SEP&gt;ĐỒN NÀ NGẦN</data>
    </node>
