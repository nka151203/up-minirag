# OpenAI-compatible endpoint (bắt buộc điền)
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key
LLM_MODEL=gpt-4o-mini

# Embedding: mặc định dùng HF local all-MiniLM-L6-v2 (không cần điền).
# Nếu muốn dùng embedding qua chính endpoint trên, bỏ comment các dòng sau:
# EMBEDDING_BACKEND=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536
